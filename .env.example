# Copy to .env (or .env.production) and fill in for the target deployment.
#
# Every value here is read at BUILD time, not runtime: they are baked into the bundle, and the two
# origins below are baked into the Content-Security-Policy that vite.config.js injects into
# index.html.

# The backend's origin. Used for every API call, and named in the CSP's connect-src.
VITE_API_BASE_URL=http://localhost:8080

# Every origin media is served from -- host only, no path. Comma- or space-separated.
#
# The app never constructs a storage URL itself (the backend mints every one), so this exists
# purely so the CSP can allow them. LEAVING IT UNSET BUILDS AN APP THAT CANNOT PLAY VIDEO OR OPEN
# A BOOK: connect-src/media-src/img-src will not include the storage host and the browser blocks
# the request as a CSP violation. The build warns when it is missing.
#
# A LIST because HLS split storage in two. Video segments come from the media delivery host
# (app.media.delivery.base-url in the backend), while book PDFs and an owner's pre-transcode
# preview are still presigned against the S3 endpoint. Name both once they differ -- locally they
# are the same MinIO host, so one entry is enough and the second origin will be missed by anyone
# who only tests locally.
#
#   local MinIO:  http://localhost:9000
#   live:         https://media.absarna.com,https://<account_id>.r2.cloudflarestorage.com
VITE_STORAGE_ORIGIN=http://localhost:9000

# The address readers write to: support, privacy requests, and -- the one that matters legally --
# copyright takedown and abuse complaints.
#
# THERE IS NO DEFAULT AND NO FALLBACK, on purpose. An invented address renders a `mailto:` that
# looks entirely normal, so a complaint is written, sent, and silently lost; an empty one makes the
# Contact page say the address is not configured yet, which is ugly and true. Leaving it unset does
# not break the build or any other page.
#
# WHAT DEPENDS ON IT: /contact is the only route to a human on this platform, and both /privacy and
# /terms name it as THE channel for a takedown notice, a complaint about a channel, a privacy or
# data request, and an account-deletion request -- which is not self-service, so an unanswered
# mailbox means a reader has no way at all to have their account removed. Ship it configured, and
# make sure somebody actually reads the mailbox.
VITE_CONTACT_EMAIL=
