# Copy to .env (or .env.production) and fill in for the target deployment.
#
# Both values are read at BUILD time, not runtime: they are baked into the bundle and into the
# Content-Security-Policy that vite.config.js injects into index.html.

# The backend's origin. Used for every API call, and named in the CSP's connect-src.
VITE_API_BASE_URL=http://localhost:8080

# Every origin media is served from -- host only, no path. Comma- or space-separated.
#
# The app never constructs a storage URL itself (the backend mints every one), so this exists
# purely so the CSP can allow them. LEAVING IT UNSET BUILDS AN APP THAT CANNOT PLAY VIDEO OR OPEN
# A BOOK: connect-src/media-src/img-src will not include the storage host and the browser blocks
# the request as a CSP violation. The build warns when it is missing.
#
# A LIST because HLS split storage in two. Video segments come from the media delivery host
# (app.media.delivery.base-url in the backend), while book PDFs and an owner's pre-transcode
# preview are still presigned against the S3 endpoint. Name both once they differ -- locally they
# are the same MinIO host, so one entry is enough and the second origin will be missed by anyone
# who only tests locally.
#
#   local MinIO:  http://localhost:9000
#   live:         https://media.absarna.com,https://<account_id>.r2.cloudflarestorage.com
VITE_STORAGE_ORIGIN=http://localhost:9000
