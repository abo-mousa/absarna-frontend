# OS
.DS_Store

# Personal, machine-specific: grants read access to the two sibling repos so a
# cross-repo review can read them. Absolute paths, so it must not be committed.
.claude/settings.local.json

# Local overrides stay on the machine. `.env.production` IS tracked: every VITE_* value is
# compiled into the public bundle and its CSP anyway, so it holds nothing a visitor cannot read,
# and tracking it means any machine can build the live site. Never put a secret in a VITE_ var.
.env
.env.local
